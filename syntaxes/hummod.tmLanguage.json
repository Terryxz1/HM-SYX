{
  "scopeName": "source.hummod",
  "name": "HumMod DES",
  "patterns": [
    {
  "comment": "============================= Global Naming ============================="
},
    {
      "name": "meta.globalvar.hummod",
      "match": "([a-zA-Z0-9_\\-]+)(\\.)(\\[[^\\]]+\\]|[a-zA-Z0-9_\\-]+)",
      "captures": {
        "1": { "name": "variable.structurename.hummod" },
        "2": { "name": "punctuation.separator.dot.hummod" },
        "3": { "name": "variable.elementname.hummod" }
      }
    },
    
{
  "comment": "============================= Unmarked Text ============================="
},

{
  "name": "text.prologue.hummod",
  "match": "^\\s*[^<\\s][^<]*",
  "comment": "Matches free-floating text, even with leading whitespace, but skips lines starting with <"
},
 {
  "comment": "============================= If, Ifnot and Create Processing Commands ============================="
},
{
  "name": "meta.instruction.create.hummod",
  "match": "<\\?create\\s+[^?>]+\\?>"
},
{
  "name": "meta.instruction.if.hummod",
  "match": "<\\?if\\s+[^?>]+\\?>"
},
{
  "name": "meta.instruction.ifnot.hummod",
  "match": "<\\?ifnot\\s+[^?>]+\\?>"
},
{
  "comment": "====================== Include Processing Command Filepath ======================="
},
{
  "name": "meta.instruction.include.hummod",
  "begin": "<\\?include\\s+",
  "beginCaptures": {
    "0": {
      "name": "keyword.directive.include.hummod"
    }
  },
  "end": "\\?>",
  "patterns": [
    {
      "name": "string.path.include.hummod",
      "match": "[^\\s?>]+"
    }
  ]
},
{
  "comment": "======================= Path Processing Command Filepath ======================="
},
{
  "name": "meta.instruction.path.hummod",
  "begin": "<\\?path\\s+",
  "beginCaptures": {
    "0": {
      "name": "keyword.directive.path.hummod"
    }
  },
  "end": "\\?>",
  "patterns": [
    {
      "name": "string.path.path.hummod",
      "match": "[^\\s?>]+"
    }
  ]
},
{
  "comment": "============================= Text within <val> ============================="
},
{
  "name": "meta.val.block.hummod",
  "begin": "(<val>)",
  "beginCaptures": {
    "1": {
      "name": "entity.name.tag.val.hummod"
    }
  },
  "end": "(</val>)",
  "endCaptures": {
    "1": {
      "name": "entity.name.tag.val.hummod"
    }
  },
  "patterns": [
    {
      "name": "meta.globalvar.hummod",
      "match": "([a-zA-Z0-9_\\-]+)(\\.)(\\[[^\\]]+\\]|[a-zA-Z0-9_\\-]+)",
      "captures": {
        "1": { "name": "variable.structurename.hummod" },
        "2": { "name": "punctuation.separator.dot.hummod" },
        "3": { "name": "variable.elementname.hummod" }
      }
    },
    {
      "name": "constant.numeric.val-content.hummod",
      "match": "[^<>()\\s]+"
    },
    {
      "name": "punctuation.parens.hummod",
      "match": "[()]",
      "comment": "Matches opening and closing parentheses"
    }
  ]
},

 {
  "comment": "============================= <Tags> ============================="
},
{
  "name": "meta.name.block.hummod",
  "begin": "(<name>)",
  "beginCaptures": {
    "1": {
      "name": "entity.name.tag.name.hummod"
    }
  },
  "end": "(</name>)",
  "endCaptures": {
    "1": {
      "name": "entity.name.tag.name.hummod"
    }
  },
  "patterns": [
    {
      "name": "meta.globalvar.hummod",
      "match": "([a-zA-Z0-9_\\-]+)(\\.)(\\[[^\\]]+\\]|[a-zA-Z0-9_\\-]+)",
      "captures": {
        "1": { "name": "variable.structurename.hummod" },
        "2": { "name": "punctuation.separator.dot.hummod" },
        "3": { "name": "variable.elementname.hummod" }
      }
    },
    {
      "name": "variable.parameter.name-content.hummod",
      "match": "[^<.]+",
      "comment": "Matches individual names, but skips dot to avoid matching global vars"
    }

  ]
},

