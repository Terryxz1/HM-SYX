{
  "name": "hummod-syntax",
  "displayName": "HumMod-Syntax",
  "description": "Syntax highlighting for Coleman's HumMod Schema found in .DES files",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
 
  "contributes": {
    "languages": [
    {
      "id": "hummod",
      "aliases": ["HumMod", "hummod"],
      "extensions": [".DES"],
      "configuration": "./language-configuration.json"
    }
  ],
  
  "grammars": [
    {
      "language": "hummod",
      "scopeName": "source.hummod",
      "path": "./syntaxes/hummod.tmLanguage.json"
    }
  ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.107.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.48.1",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
